[
  {
    "id": "u1a",
    "unit": 1,
    "part": "a",
    "title": "Different friends",
    "page": 4,
    "lines": [
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "Hi, class.",
        "audio": "text-e3a1f9b87897ecb1",
        "voice": "en-GB-SoniaNeural",
        "translation": "同学们好。",
        "audioPack": "text-u1a-01-d9df706f7f3c.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "You'll have a new classmate.",
        "audio": "text-1a6ec85cdd9667f8",
        "voice": "en-GB-SoniaNeural",
        "translation": "你们班要来一位新同学。",
        "audioPack": "text-u1a-01-d9df706f7f3c.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "He's from Australia.",
        "audio": "text-f51725edfb7a4a65",
        "voice": "en-GB-SoniaNeural",
        "translation": "他来自澳大利亚。",
        "audioPack": "text-u1a-01-d9df706f7f3c.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "His name is Oliver.",
        "audio": "text-442ce23189396008",
        "voice": "en-GB-SoniaNeural",
        "translation": "他叫奥利弗。",
        "audioPack": "text-u1a-02-610b8475f4e8.json"
      },
      {
        "speaker": "Mike",
        "gender": "male",
        "text": "What's he like?",
        "audio": "text-f0a3c6e1cc81724a",
        "voice": "en-GB-RyanNeural",
        "translation": "他是什么样的人？",
        "audioPack": "text-u1a-02-610b8475f4e8.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "He's tall and strong.",
        "audio": "text-4f09663e28b899e8",
        "voice": "en-GB-SoniaNeural",
        "translation": "他又高又壮。",
        "audioPack": "text-u1a-02-610b8475f4e8.json"
      },
      {
        "speaker": "Zhang Peng",
        "gender": "male",
        "text": "Is he good at football?",
        "audio": "text-1c6dab5ecebb95dc",
        "voice": "en-GB-RyanNeural",
        "translation": "他擅长踢足球吗？",
        "audioPack": "text-u1a-03-607f2fe67d97.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "Yes, I think he is.",
        "audio": "text-a23623bfeebd0fe6",
        "voice": "en-GB-SoniaNeural",
        "translation": "嗯，我想他擅长。",
        "audioPack": "text-u1a-03-607f2fe67d97.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "He can run very fast.",
        "audio": "text-163150e5e8d2a5bd",
        "voice": "en-GB-SoniaNeural",
        "translation": "他跑得很快。",
        "audioPack": "text-u1a-03-607f2fe67d97.json"
      },
      {
        "speaker": "Zhang Peng",
        "gender": "male",
        "text": "Great!",
        "audio": "text-a34b2bbafa1f1bc2",
        "voice": "en-GB-RyanNeural",
        "translation": "太好了！",
        "audioPack": "text-u1a-04-60716c792528.json"
      },
      {
        "speaker": "Zhang Peng",
        "gender": "male",
        "text": "Our football team needs more players.",
        "audio": "text-4f69b37694548ed5",
        "voice": "en-GB-RyanNeural",
        "translation": "我们的足球队还需要更多队员。",
        "audioPack": "text-u1a-04-60716c792528.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "Oliver can't speak Chinese.",
        "audio": "text-1125fc51c04534e5",
        "voice": "en-GB-SoniaNeural",
        "translation": "奥利弗不会说中文。",
        "audioPack": "text-u1a-04-60716c792528.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "Would you like to help him, Zhang Peng?",
        "audio": "text-be5a500a14b9585c",
        "voice": "en-GB-SoniaNeural",
        "translation": "张鹏，你愿意帮帮他吗？",
        "audioPack": "text-u1a-05-b6811ccd2dce.json"
      },
      {
        "speaker": "Zhang Peng",
        "gender": "male",
        "text": "Sure!",
        "audio": "text-c48ae4309b057add",
        "voice": "en-GB-RyanNeural",
        "translation": "当然！",
        "audioPack": "text-u1a-05-b6811ccd2dce.json"
      }
    ]
  },
  {
    "id": "u1b",
    "unit": 1,
    "part": "b",
    "title": "Different friends",
    "page": 7,
    "lines": [
      {
        "speaker": "Binbin",
        "gender": "male",
        "text": "The Science and Art Festival is in two weeks.",
        "audio": "text-8a9e848b55f6841c",
        "voice": "en-GB-RyanNeural",
        "translation": "再过两周就是科技艺术节了。",
        "audioPack": "text-u1b-01-ad6ff18a7755.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "Yes.",
        "audio": "text-f95beee2379abe90",
        "voice": "en-GB-SoniaNeural",
        "translation": "是啊。",
        "audioPack": "text-u1b-01-ad6ff18a7755.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "What can you do for the festival?",
        "audio": "text-b8b0d68316421852",
        "voice": "en-GB-SoniaNeural",
        "translation": "你能为艺术节做些什么？",
        "audioPack": "text-u1b-01-ad6ff18a7755.json"
      },
      {
        "speaker": "Binbin",
        "gender": "male",
        "text": "I can make a robot.",
        "audio": "text-575f98dd26296de3",
        "voice": "en-GB-RyanNeural",
        "translation": "我能做一个机器人。",
        "audioPack": "text-u1b-02-d00878c2f9c4.json"
      },
      {
        "speaker": "Oliver",
        "gender": "male",
        "text": "Oh!",
        "audio": "text-5d570d3231bb402a",
        "voice": "en-GB-RyanNeural",
        "translation": "哦！",
        "audioPack": "text-u1b-02-d00878c2f9c4.json"
      },
      {
        "speaker": "Oliver",
        "gender": "male",
        "text": "I like making robots too.",
        "audio": "text-f3e7188cf55f63c9",
        "voice": "en-GB-RyanNeural",
        "translation": "我也喜欢做机器人。",
        "audioPack": "text-u1b-02-d00878c2f9c4.json"
      },
      {
        "speaker": "Oliver",
        "gender": "male",
        "text": "We can work together.",
        "audio": "text-63dd1b1c5c10b96c",
        "voice": "en-GB-RyanNeural",
        "translation": "我们可以一起做。",
        "audioPack": "text-u1b-03-8fd9aee64433.json"
      },
      {
        "speaker": "Binbin",
        "gender": "male",
        "text": "Great!",
        "audio": "text-a34b2bbafa1f1bc2",
        "voice": "en-GB-RyanNeural",
        "translation": "太好了！",
        "audioPack": "text-u1b-03-8fd9aee64433.json"
      },
      {
        "speaker": "Binbin",
        "gender": "male",
        "text": "Can you make robots, Sarah?",
        "audio": "text-7b7ad02ab0f3be71",
        "voice": "en-GB-RyanNeural",
        "translation": "萨拉，你会做机器人吗？",
        "audioPack": "text-u1b-03-8fd9aee64433.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "No, I can't.",
        "audio": "text-ae6565bf4f1645d9",
        "voice": "en-GB-SoniaNeural",
        "translation": "不，我不会。",
        "audioPack": "text-u1b-04-95c1261cc466.json"
      },
      {
        "speaker": "Oliver",
        "gender": "male",
        "text": "What can you do?",
        "audio": "text-bfd2ce666e4d73ed",
        "voice": "en-GB-RyanNeural",
        "translation": "那你会做什么？",
        "audioPack": "text-u1b-04-95c1261cc466.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "I can dance.",
        "audio": "text-421319dcee39b7f7",
        "voice": "en-GB-SoniaNeural",
        "translation": "我会跳舞。",
        "audioPack": "text-u1b-04-95c1261cc466.json"
      },
      {
        "speaker": "Oliver",
        "gender": "male",
        "text": "That's great!",
        "audio": "text-bc51089c043fc5a9",
        "voice": "en-GB-RyanNeural",
        "translation": "太棒了！",
        "audioPack": "text-u1b-05-9553015ce015.json"
      }
    ]
  },
  {
    "id": "u2a",
    "unit": 2,
    "part": "a",
    "title": "My feelings",
    "page": 16,
    "lines": [
      {
        "speaker": "Chen Jie",
        "gender": "female",
        "text": "Hi, Mike.",
        "audio": "text-863cf600c6bc5615",
        "voice": "en-GB-SoniaNeural",
        "translation": "你好，迈克。",
        "audioPack": "text-u2a-01-a2b5c0a63952.json"
      },
      {
        "speaker": "Chen Jie",
        "gender": "female",
        "text": "You look sad.",
        "audio": "text-e4b98171edf009ca",
        "voice": "en-GB-SoniaNeural",
        "translation": "你看起来不太开心。",
        "audioPack": "text-u2a-01-a2b5c0a63952.json"
      },
      {
        "speaker": "Chen Jie",
        "gender": "female",
        "text": "What's the matter?",
        "audio": "text-514168b9aef8c321",
        "voice": "en-GB-SoniaNeural",
        "translation": "怎么了？",
        "audioPack": "text-u2a-01-a2b5c0a63952.json"
      },
      {
        "speaker": "Mike",
        "gender": "male",
        "text": "It's about our school project.",
        "audio": "text-1892f0b832b4a1fa",
        "voice": "en-GB-RyanNeural",
        "translation": "是学校活动项目的事。",
        "audioPack": "text-u2a-02-ffdf675f9c58.json"
      },
      {
        "speaker": "Mike",
        "gender": "male",
        "text": "John wants to go to the children's centre, but I want to clean up the park.",
        "audio": "text-50b743898d456143",
        "voice": "en-GB-RyanNeural",
        "translation": "约翰想去儿童活动中心，可我想打扫公园。",
        "audioPack": "text-u2a-02-ffdf675f9c58.json"
      },
      {
        "speaker": "Chen Jie",
        "gender": "female",
        "text": "I see.",
        "audio": "text-795ddc3826d3c816",
        "voice": "en-GB-SoniaNeural",
        "translation": "我明白了。",
        "audioPack": "text-u2a-02-ffdf675f9c58.json"
      },
      {
        "speaker": "Chen Jie",
        "gender": "female",
        "text": "So you don't agree with each other?",
        "audio": "text-290d3cf45a75e4b7",
        "voice": "en-GB-SoniaNeural",
        "translation": "所以你们的想法不一样？",
        "audioPack": "text-u2a-03-ac8520b214ae.json"
      },
      {
        "speaker": "Mike",
        "gender": "male",
        "text": "That's right.",
        "audio": "text-43e512b6a0ffeb54",
        "voice": "en-GB-RyanNeural",
        "translation": "没错。",
        "audioPack": "text-u2a-03-ac8520b214ae.json"
      },
      {
        "speaker": "Mike",
        "gender": "male",
        "text": "And we have to finish our project by Monday.",
        "audio": "text-75aaeef3fe5b060d",
        "voice": "en-GB-RyanNeural",
        "translation": "而且我们最晚得在星期一完成这个项目。",
        "audioPack": "text-u2a-03-ac8520b214ae.json"
      },
      {
        "speaker": "Mike",
        "gender": "male",
        "text": "I'm so worried!",
        "audio": "text-230809dda9930aac",
        "voice": "en-GB-RyanNeural",
        "translation": "我好担心啊！",
        "audioPack": "text-u2a-04-3b0bf3e743e9.json"
      },
      {
        "speaker": "Chen Jie",
        "gender": "female",
        "text": "Why not do both?",
        "audio": "text-7f10854c2e5933ce",
        "voice": "en-GB-SoniaNeural",
        "translation": "为什么不把两件事都做了呢？",
        "audioPack": "text-u2a-04-3b0bf3e743e9.json"
      },
      {
        "speaker": "Chen Jie",
        "gender": "female",
        "text": "I can help.",
        "audio": "text-06e12dba0c5eb288",
        "voice": "en-GB-SoniaNeural",
        "translation": "我可以帮忙。",
        "audioPack": "text-u2a-04-3b0bf3e743e9.json"
      },
      {
        "speaker": "Chen Jie",
        "gender": "female",
        "text": "We can work together.",
        "audio": "text-456da6d25a1fe4d0",
        "voice": "en-GB-SoniaNeural",
        "translation": "我们可以一起做。",
        "audioPack": "text-u2a-05-d80d0e053a02.json"
      },
      {
        "speaker": "Mike",
        "gender": "male",
        "text": "That's a good idea!",
        "audio": "text-70f9fb7da6367b25",
        "voice": "en-GB-RyanNeural",
        "translation": "这主意不错！",
        "audioPack": "text-u2a-05-d80d0e053a02.json"
      }
    ]
  },
  {
    "id": "u2b",
    "unit": 2,
    "part": "b",
    "title": "My feelings",
    "page": 19,
    "lines": [
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "What's the matter, John?",
        "audio": "text-d474fba95d459ded",
        "voice": "en-GB-SoniaNeural",
        "translation": "怎么了，约翰？",
        "audioPack": "text-u2b-01-5f0adea3e477.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "You look worried.",
        "audio": "text-fee4b354f1e9ca08",
        "voice": "en-GB-SoniaNeural",
        "translation": "你看起来很担心。",
        "audioPack": "text-u2b-01-5f0adea3e477.json"
      },
      {
        "speaker": "John",
        "gender": "male",
        "text": "It's about our project.",
        "audio": "text-66fa221d1a97c9a1",
        "voice": "en-GB-RyanNeural",
        "translation": "是我们那个项目的事。",
        "audioPack": "text-u2b-01-5f0adea3e477.json"
      },
      {
        "speaker": "John",
        "gender": "male",
        "text": "Mike and I want to do different things.",
        "audio": "text-c7f2211711dc9cd5",
        "voice": "en-GB-RyanNeural",
        "translation": "迈克和我想做的事不一样。",
        "audioPack": "text-u2b-02-d3135fb38cb4.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "I see.",
        "audio": "text-795ddc3826d3c816",
        "voice": "en-GB-SoniaNeural",
        "translation": "我明白了。",
        "audioPack": "text-u2b-02-d3135fb38cb4.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "It's important to listen to each other.",
        "audio": "text-4af8e514788a29ca",
        "voice": "en-GB-SoniaNeural",
        "translation": "听听对方的想法很重要。",
        "audioPack": "text-u2b-02-d3135fb38cb4.json"
      },
      {
        "speaker": "John",
        "gender": "male",
        "text": "Yes, Miss White.",
        "audio": "text-e63108678b818cf3",
        "voice": "en-GB-RyanNeural",
        "translation": "是的，怀特老师。",
        "audioPack": "text-u2b-03-b96131645857.json"
      },
      {
        "speaker": "John",
        "gender": "male",
        "text": "I need to talk to Mike.",
        "audio": "text-7131c727c8b2b83f",
        "voice": "en-GB-RyanNeural",
        "translation": "我得跟迈克谈谈。",
        "audioPack": "text-u2b-03-b96131645857.json"
      },
      {
        "speaker": "John",
        "gender": "male",
        "text": "But I'm afraid he's angry with me.",
        "audio": "text-2b169f0671d803ca",
        "voice": "en-GB-RyanNeural",
        "translation": "可我怕他生我的气。",
        "audioPack": "text-u2b-03-b96131645857.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "Look, here he comes.",
        "audio": "text-97ed0ed12188abdc",
        "voice": "en-GB-SoniaNeural",
        "translation": "看，他来了。",
        "audioPack": "text-u2b-04-dd44c95b70d8.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "You can talk to him now.",
        "audio": "text-cec2ab9b49444619",
        "voice": "en-GB-SoniaNeural",
        "translation": "你现在就可以跟他说。",
        "audioPack": "text-u2b-04-dd44c95b70d8.json"
      },
      {
        "speaker": "Mike",
        "gender": "male",
        "text": "John, I'm sorry.",
        "audio": "text-d53063fed91d63f3",
        "voice": "en-GB-RyanNeural",
        "translation": "约翰，对不起。",
        "audioPack": "text-u2b-04-dd44c95b70d8.json"
      },
      {
        "speaker": "Mike",
        "gender": "male",
        "text": "Let's do both projects!",
        "audio": "text-bdb4c8b72cb0c32b",
        "voice": "en-GB-RyanNeural",
        "translation": "我们两个项目都做吧！",
        "audioPack": "text-u2b-05-2e32ead903d5.json"
      },
      {
        "speaker": "Mike",
        "gender": "male",
        "text": "Chen Jie can work with us.",
        "audio": "text-f9459c8eecc31621",
        "voice": "en-GB-RyanNeural",
        "translation": "陈洁可以和我们一起做。",
        "audioPack": "text-u2b-05-2e32ead903d5.json"
      },
      {
        "speaker": "John",
        "gender": "male",
        "text": "That's great!",
        "audio": "text-bc51089c043fc5a9",
        "voice": "en-GB-RyanNeural",
        "translation": "太棒了！",
        "audioPack": "text-u2b-05-2e32ead903d5.json"
      }
    ]
  },
  {
    "id": "u3a",
    "unit": 3,
    "part": "a",
    "title": "Work and play",
    "page": 28,
    "lines": [
      {
        "speaker": "Grandpa",
        "gender": "male",
        "text": "What's your favourite day at school, John?",
        "audio": "text-57721225d19d86ce",
        "voice": "en-GB-RyanNeural",
        "translation": "约翰，你最喜欢哪一天上学？",
        "audioPack": "text-u3a-01-941b468fd216.json"
      },
      {
        "speaker": "John",
        "gender": "male",
        "text": "Wednesday.",
        "audio": "text-c6e4ef4f48473df6",
        "voice": "en-GB-RyanNeural",
        "translation": "星期三。",
        "audioPack": "text-u3a-01-941b468fd216.json"
      },
      {
        "speaker": "Grandpa",
        "gender": "male",
        "text": "What do you have on Wednesdays?",
        "audio": "text-94fb7f0d3b5248a3",
        "voice": "en-GB-RyanNeural",
        "translation": "你星期三有什么课？",
        "audioPack": "text-u3a-01-941b468fd216.json"
      },
      {
        "speaker": "John",
        "gender": "male",
        "text": "I have Chinese, maths, music and PE.",
        "audio": "text-b7fe65d1f849fd90",
        "voice": "en-GB-RyanNeural",
        "translation": "我有语文、数学、音乐和体育课。",
        "audioPack": "text-u3a-02-2b888454c95c.json"
      },
      {
        "speaker": "Grandpa",
        "gender": "male",
        "text": "Maths is not easy.",
        "audio": "text-c29e34c258e5b570",
        "voice": "en-GB-RyanNeural",
        "translation": "数学可不容易。",
        "audioPack": "text-u3a-02-2b888454c95c.json"
      },
      {
        "speaker": "John",
        "gender": "male",
        "text": "No, but I really like my maths teacher!",
        "audio": "text-ba70f5a53f8dea8f",
        "voice": "en-GB-RyanNeural",
        "translation": "是不容易，不过我很喜欢我的数学老师！",
        "audioPack": "text-u3a-02-2b888454c95c.json"
      },
      {
        "speaker": "Grandpa",
        "gender": "male",
        "text": "That's good.",
        "audio": "text-50b6738b11996735",
        "voice": "en-GB-RyanNeural",
        "translation": "那很好。",
        "audioPack": "text-u3a-03-461fbbc11e12.json"
      },
      {
        "speaker": "Grandpa",
        "gender": "male",
        "text": "Is music your favourite subject?",
        "audio": "text-d022e345516b6ba1",
        "voice": "en-GB-RyanNeural",
        "translation": "音乐是你最喜欢的科目吗？",
        "audioPack": "text-u3a-03-461fbbc11e12.json"
      },
      {
        "speaker": "John",
        "gender": "male",
        "text": "Yes.",
        "audio": "text-37cb92bfecdfab71",
        "voice": "en-GB-RyanNeural",
        "translation": "是的。",
        "audioPack": "text-u3a-03-461fbbc11e12.json"
      },
      {
        "speaker": "John",
        "gender": "male",
        "text": "I really like singing.",
        "audio": "text-a7dd09a46aa36edc",
        "voice": "en-GB-RyanNeural",
        "translation": "我特别喜欢唱歌。",
        "audioPack": "text-u3a-04-c86e4061993b.json"
      },
      {
        "speaker": "John",
        "gender": "male",
        "text": "And I like PE too.",
        "audio": "text-6054444bf9cf9811",
        "voice": "en-GB-RyanNeural",
        "translation": "我也喜欢体育课。",
        "audioPack": "text-u3a-04-c86e4061993b.json"
      },
      {
        "speaker": "Grandpa",
        "gender": "male",
        "text": "Great!",
        "audio": "text-a34b2bbafa1f1bc2",
        "voice": "en-GB-RyanNeural",
        "translation": "真棒！",
        "audioPack": "text-u3a-04-c86e4061993b.json"
      },
      {
        "speaker": "Grandpa",
        "gender": "male",
        "text": "Wednesday is your favourite day.",
        "audio": "text-58fd379c6b1419a3",
        "voice": "en-GB-RyanNeural",
        "translation": "星期三是你最喜欢的一天。",
        "audioPack": "text-u3a-05-051803383dbb.json"
      },
      {
        "speaker": "Grandpa",
        "gender": "male",
        "text": "But I like Tuesdays and Fridays.",
        "audio": "text-3afa58cff993583e",
        "voice": "en-GB-RyanNeural",
        "translation": "不过我喜欢星期二和星期五。",
        "audioPack": "text-u3a-05-051803383dbb.json"
      },
      {
        "speaker": "John",
        "gender": "male",
        "text": "Why, Grandpa?",
        "audio": "text-a92ef2a380e1f7ac",
        "voice": "en-GB-RyanNeural",
        "translation": "为什么呀，爷爷？",
        "audioPack": "text-u3a-05-051803383dbb.json"
      },
      {
        "speaker": "Grandpa",
        "gender": "male",
        "text": "Because I have my taijiquan class!",
        "audio": "text-5b52704f7ec89977",
        "voice": "en-GB-RyanNeural",
        "translation": "因为这两天我有太极拳课！",
        "audioPack": "text-u3a-06-90fea6de4c8c.json"
      }
    ]
  },
  {
    "id": "u3b",
    "unit": 3,
    "part": "b",
    "title": "Work and play",
    "page": 31,
    "lines": [
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "What do you usually do at the weekend, children?",
        "audio": "text-fb85373c9bdb3e10",
        "voice": "en-GB-SoniaNeural",
        "translation": "孩子们，你们周末通常做什么？",
        "audioPack": "text-u3b-01-0bc633992f15.json"
      },
      {
        "speaker": "Zhang Peng",
        "gender": "male",
        "text": "I often play football.",
        "audio": "text-c5207419340ad2f6",
        "voice": "en-GB-RyanNeural",
        "translation": "我经常踢足球。",
        "audioPack": "text-u3b-01-0bc633992f15.json"
      },
      {
        "speaker": "Zhang Peng",
        "gender": "male",
        "text": "Sometimes I play Chinese chess with my father.",
        "audio": "text-30a6cc070e1e2482",
        "voice": "en-GB-RyanNeural",
        "translation": "有时我和爸爸下中国象棋。",
        "audioPack": "text-u3b-01-0bc633992f15.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "That's nice.",
        "audio": "text-e4348f51e8928869",
        "voice": "en-GB-SoniaNeural",
        "translation": "真不错。",
        "audioPack": "text-u3b-02-95106bdb6621.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "My mother works at the weekend, so I often cook lunch for my family.",
        "audio": "text-8c52f78b7b54011b",
        "voice": "en-GB-SoniaNeural",
        "translation": "我妈妈周末要上班，所以我常给家人做午饭。",
        "audioPack": "text-u3b-02-95106bdb6621.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "Good girl!",
        "audio": "text-dd77f2197ba3b853",
        "voice": "en-GB-SoniaNeural",
        "translation": "你真懂事！",
        "audioPack": "text-u3b-02-95106bdb6621.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "Does your mother work on Saturdays and Sundays?",
        "audio": "text-98d665c82453c308",
        "voice": "en-GB-SoniaNeural",
        "translation": "你妈妈星期六和星期日都上班吗？",
        "audioPack": "text-u3b-03-6a3e1bab7cbc.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "Yes, she does.",
        "audio": "text-c0e898923236db89",
        "voice": "en-GB-SoniaNeural",
        "translation": "是的，她都上班。",
        "audioPack": "text-u3b-03-6a3e1bab7cbc.json"
      },
      {
        "speaker": "Chen Jie",
        "gender": "female",
        "text": "I do my homework on Saturdays.",
        "audio": "text-5a2b6c202fa3a0c2",
        "voice": "en-GB-SoniaNeural",
        "translation": "我星期六做作业。",
        "audioPack": "text-u3b-03-6a3e1bab7cbc.json"
      },
      {
        "speaker": "Chen Jie",
        "gender": "female",
        "text": "And I usually have pipa lessons on Sundays.",
        "audio": "text-d1c12f7181a20031",
        "voice": "en-GB-SoniaNeural",
        "translation": "星期日我通常上琵琶课。",
        "audioPack": "text-u3b-04-f61aa3e7a8c8.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "Great!",
        "audio": "text-87d7cb607937a4c5",
        "voice": "en-GB-SoniaNeural",
        "translation": "真棒！",
        "audioPack": "text-u3b-04-f61aa3e7a8c8.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "Have a nice weekend, everyone!",
        "audio": "text-58137d4af023f57c",
        "voice": "en-GB-SoniaNeural",
        "translation": "祝大家周末愉快！",
        "audioPack": "text-u3b-04-f61aa3e7a8c8.json"
      }
    ]
  },
  {
    "id": "u4a",
    "unit": 4,
    "part": "a",
    "title": "Healthy habits",
    "page": 40,
    "lines": [
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "Mike has a cold today, children.",
        "audio": "text-093238f1da5c4200",
        "voice": "en-GB-SoniaNeural",
        "translation": "孩子们，迈克今天感冒了。",
        "audioPack": "text-u4a-01-3194084be5c8.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "He has to stay at home.",
        "audio": "text-b171cab99666d9d8",
        "voice": "en-GB-SoniaNeural",
        "translation": "他得待在家里。",
        "audioPack": "text-u4a-01-3194084be5c8.json"
      },
      {
        "speaker": "Binbin",
        "gender": "male",
        "text": "Oh no!",
        "audio": "text-0b10d4b5c7f17692",
        "voice": "en-GB-RyanNeural",
        "translation": "哎呀！",
        "audioPack": "text-u4a-01-3194084be5c8.json"
      },
      {
        "speaker": "Binbin",
        "gender": "male",
        "text": "It's flu season now.",
        "audio": "text-ce001dab61c2a6b5",
        "voice": "en-GB-RyanNeural",
        "translation": "现在是流感季节。",
        "audioPack": "text-u4a-02-6258e28e096f.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "That's right.",
        "audio": "text-7d31a2d2222891d1",
        "voice": "en-GB-SoniaNeural",
        "translation": "没错。",
        "audioPack": "text-u4a-02-6258e28e096f.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "How can we all stay healthy?",
        "audio": "text-28f419eb81a47f7c",
        "voice": "en-GB-SoniaNeural",
        "translation": "我们怎样才能保持健康呢？",
        "audioPack": "text-u4a-02-6258e28e096f.json"
      },
      {
        "speaker": "Amy",
        "gender": "female",
        "text": "We should eat healthy food.",
        "audio": "text-b68c13d6f1f8b85b",
        "voice": "en-GB-SoniaNeural",
        "translation": "我们应该吃健康的食物。",
        "audioPack": "text-u4a-03-e20504034aca.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "Good.",
        "audio": "text-23a4555b774f9dfe",
        "voice": "en-GB-SoniaNeural",
        "translation": "说得好。",
        "audioPack": "text-u4a-03-e20504034aca.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "And what else?",
        "audio": "text-2799b3c2a397714a",
        "voice": "en-GB-SoniaNeural",
        "translation": "还有呢？",
        "audioPack": "text-u4a-03-e20504034aca.json"
      },
      {
        "speaker": "Zhang Peng",
        "gender": "male",
        "text": "We should exercise every day.",
        "audio": "text-85f8ec29411604ba",
        "voice": "en-GB-RyanNeural",
        "translation": "我们应该每天锻炼。",
        "audioPack": "text-u4a-04-10c8db97d09c.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "Yes, but please drink enough water.",
        "audio": "text-c9a604f42e9fed86",
        "voice": "en-GB-SoniaNeural",
        "translation": "对，不过也要喝够水。",
        "audioPack": "text-u4a-04-10c8db97d09c.json"
      },
      {
        "speaker": "Chen Jie",
        "gender": "female",
        "text": "We should also get enough sleep, Miss White.",
        "audio": "text-ffe0892e9525c90b",
        "voice": "en-GB-SoniaNeural",
        "translation": "怀特老师，我们还应该睡够觉。",
        "audioPack": "text-u4a-04-10c8db97d09c.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "Right.",
        "audio": "text-88a497e5149a146b",
        "voice": "en-GB-SoniaNeural",
        "translation": "对。",
        "audioPack": "text-u4a-05-97dbb64f998e.json"
      },
      {
        "speaker": "Miss White",
        "gender": "female",
        "text": "And if you don't feel well, you should see a doctor.",
        "audio": "text-6d28e14006f1f21c",
        "voice": "en-GB-SoniaNeural",
        "translation": "如果觉得不舒服，就应该去看医生。",
        "audioPack": "text-u4a-05-97dbb64f998e.json"
      }
    ]
  },
  {
    "id": "u4b",
    "unit": 4,
    "part": "b",
    "title": "Healthy habits",
    "page": 43,
    "lines": [
      {
        "speaker": "Sam",
        "gender": "male",
        "text": "Can I watch a TV show now, please?",
        "audio": "text-6915a002c75ccd0b",
        "voice": "en-GB-RyanNeural",
        "translation": "我现在可以看一会儿电视节目吗？",
        "audioPack": "text-u4b-01-2359188f068e.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "No, I'm afraid not.",
        "audio": "text-d4dc6a974e214039",
        "voice": "en-GB-SoniaNeural",
        "translation": "恐怕不行。",
        "audioPack": "text-u4b-01-2359188f068e.json"
      },
      {
        "speaker": "Sam",
        "gender": "male",
        "text": "Can I play on Mum's phone?",
        "audio": "text-10dd4d3a65eda263",
        "voice": "en-GB-RyanNeural",
        "translation": "那我可以玩妈妈的手机吗？",
        "audioPack": "text-u4b-01-2359188f068e.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "No.",
        "audio": "text-8f81c4ec41be0f4f",
        "voice": "en-GB-SoniaNeural",
        "translation": "不行。",
        "audioPack": "text-u4b-02-24b937f833b7.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "You shouldn't play on a phone so often.",
        "audio": "text-1fd7e404ec7c1627",
        "voice": "en-GB-SoniaNeural",
        "translation": "你不应该老是玩手机。",
        "audioPack": "text-u4b-02-24b937f833b7.json"
      },
      {
        "speaker": "Sam",
        "gender": "male",
        "text": "What should I do then?",
        "audio": "text-11787af110cfcd3d",
        "voice": "en-GB-RyanNeural",
        "translation": "那我该做什么呢？",
        "audioPack": "text-u4b-02-24b937f833b7.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "You should rest your eyes.",
        "audio": "text-bd63453cd85cb9ec",
        "voice": "en-GB-SoniaNeural",
        "translation": "你该让眼睛休息一下。",
        "audioPack": "text-u4b-03-533e27df1cb4.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "Let's take a walk.",
        "audio": "text-44dfbb3ca7590ece",
        "voice": "en-GB-SoniaNeural",
        "translation": "我们去散步吧。",
        "audioPack": "text-u4b-03-533e27df1cb4.json"
      },
      {
        "speaker": "Sam",
        "gender": "male",
        "text": "That's no fun.",
        "audio": "text-386f7d2fea267053",
        "voice": "en-GB-RyanNeural",
        "translation": "那没意思。",
        "audioPack": "text-u4b-03-533e27df1cb4.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "OK.",
        "audio": "text-eeae18c2283e060c",
        "voice": "en-GB-SoniaNeural",
        "translation": "好吧。",
        "audioPack": "text-u4b-04-fb656bf6a431.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "Let's play in the garden then.",
        "audio": "text-d64a9e66cb3340de",
        "voice": "en-GB-SoniaNeural",
        "translation": "那我们去花园玩吧。",
        "audioPack": "text-u4b-04-fb656bf6a431.json"
      },
      {
        "speaker": "Sarah",
        "gender": "female",
        "text": "It's a nice day.",
        "audio": "text-711a54cbac18b830",
        "voice": "en-GB-SoniaNeural",
        "translation": "今天天气真好。",
        "audioPack": "text-u4b-04-fb656bf6a431.json"
      },
      {
        "speaker": "Sam",
        "gender": "male",
        "text": "Great!",
        "audio": "text-a34b2bbafa1f1bc2",
        "voice": "en-GB-RyanNeural",
        "translation": "太好了！",
        "audioPack": "text-u4b-05-3fb1aae53a4c.json"
      }
    ]
  },
  {
    "id": "u5a",
    "unit": 5,
    "part": "a",
    "title": "Food we eat",
    "page": 52,
    "lines": [
      {
        "speaker": "Oliver",
        "gender": "male",
        "text": "Mum, I'm hungry.",
        "audio": "text-4c366abc2abb8605",
        "voice": "en-GB-RyanNeural",
        "translation": "妈妈，我饿了。",
        "audioPack": "text-u5a-01-e7e239a5a4ed.json"
      },
      {
        "speaker": "Mum",
        "gender": "female",
        "text": "What would you like to eat?",
        "audio": "text-0e4a544aa3a02429",
        "voice": "en-GB-SoniaNeural",
        "translation": "你想吃什么？",
        "audioPack": "text-u5a-01-e7e239a5a4ed.json"
      },
      {
        "speaker": "Oliver",
        "gender": "male",
        "text": "I'd like beef and rice.",
        "audio": "text-eb1a523a5c2bf57e",
        "voice": "en-GB-RyanNeural",
        "translation": "我想吃牛肉和米饭。",
        "audioPack": "text-u5a-01-e7e239a5a4ed.json"
      },
      {
        "speaker": "Mum",
        "gender": "female",
        "text": "No problem.",
        "audio": "text-57849adfd05e7fe9",
        "voice": "en-GB-SoniaNeural",
        "translation": "没问题。",
        "audioPack": "text-u5a-02-4fc18e9afd23.json"
      },
      {
        "speaker": "Mum",
        "gender": "female",
        "text": "Would you like some chicken soup too?",
        "audio": "text-8ebbfee95cfc27be",
        "voice": "en-GB-SoniaNeural",
        "translation": "你还想喝点鸡汤吗？",
        "audioPack": "text-u5a-02-4fc18e9afd23.json"
      },
      {
        "speaker": "Oliver",
        "gender": "male",
        "text": "Yes, please.",
        "audio": "text-bd48cb84660ca9d1",
        "voice": "en-GB-RyanNeural",
        "translation": "好啊，谢谢。",
        "audioPack": "text-u5a-02-4fc18e9afd23.json"
      },
      {
        "speaker": "Mum",
        "gender": "female",
        "text": "You should also have some salad.",
        "audio": "text-32374905852e2857",
        "voice": "en-GB-SoniaNeural",
        "translation": "你还应该吃点沙拉。",
        "audioPack": "text-u5a-03-60c92d05f3f9.json"
      },
      {
        "speaker": "Mum",
        "gender": "female",
        "text": "Vegetables are good for you.",
        "audio": "text-c5da729ac426fce8",
        "voice": "en-GB-SoniaNeural",
        "translation": "蔬菜对身体有好处。",
        "audioPack": "text-u5a-03-60c92d05f3f9.json"
      },
      {
        "speaker": "Oliver",
        "gender": "male",
        "text": "OK.",
        "audio": "text-d3502b861fc1992d",
        "voice": "en-GB-RyanNeural",
        "translation": "好的。",
        "audioPack": "text-u5a-03-60c92d05f3f9.json"
      },
      {
        "speaker": "Oliver",
        "gender": "male",
        "text": "Can I have some ice cream, please?",
        "audio": "text-3b03c930456a9ccd",
        "voice": "en-GB-RyanNeural",
        "translation": "我可以吃点冰激凌吗？",
        "audioPack": "text-u5a-04-4def4af4fb50.json"
      },
      {
        "speaker": "Mum",
        "gender": "female",
        "text": "Yes, but just a little.",
        "audio": "text-51d38b3b34a44380",
        "voice": "en-GB-SoniaNeural",
        "translation": "可以，不过只能吃一点。",
        "audioPack": "text-u5a-04-4def4af4fb50.json"
      },
      {
        "speaker": "Oliver",
        "gender": "male",
        "text": "OK.",
        "audio": "text-d3502b861fc1992d",
        "voice": "en-GB-RyanNeural",
        "translation": "好的。",
        "audioPack": "text-u5a-04-4def4af4fb50.json"
      },
      {
        "speaker": "Oliver",
        "gender": "male",
        "text": "Thanks, Mum.",
        "audio": "text-e982ff7705fa3b9d",
        "voice": "en-GB-RyanNeural",
        "translation": "谢谢妈妈。",
        "audioPack": "text-u5a-05-551a7c5cd0e6.json"
      }
    ]
  },
  {
    "id": "u5b",
    "unit": 5,
    "part": "b",
    "title": "Food we eat",
    "page": 55,
    "lines": [
      {
        "speaker": "Mrs Green",
        "gender": "female",
        "text": "What's your favourite fruit, Binbin?",
        "audio": "text-22ecefdda2400bfe",
        "voice": "en-GB-SoniaNeural",
        "translation": "彬彬，你最喜欢什么水果？",
        "audioPack": "text-u5b-01-1e000d13d320.json"
      },
      {
        "speaker": "Binbin",
        "gender": "male",
        "text": "Coconuts are my favourite.",
        "audio": "text-883a5682eab7ec40",
        "voice": "en-GB-RyanNeural",
        "translation": "我最喜欢椰子。",
        "audioPack": "text-u5b-01-1e000d13d320.json"
      },
      {
        "speaker": "Mrs Green",
        "gender": "female",
        "text": "Why do you like coconuts?",
        "audio": "text-6596c2029e9d19f3",
        "voice": "en-GB-SoniaNeural",
        "translation": "你为什么喜欢椰子？",
        "audioPack": "text-u5b-01-1e000d13d320.json"
      },
      {
        "speaker": "Binbin",
        "gender": "male",
        "text": "Because coconut water is nice.",
        "audio": "text-a79c9325d31d6aef",
        "voice": "en-GB-RyanNeural",
        "translation": "因为椰子水很好喝。",
        "audioPack": "text-u5b-02-b80d9cbdaa75.json"
      },
      {
        "speaker": "Binbin",
        "gender": "male",
        "text": "And it's healthy.",
        "audio": "text-160e7c9de57aaf04",
        "voice": "en-GB-RyanNeural",
        "translation": "而且也很健康。",
        "audioPack": "text-u5b-02-b80d9cbdaa75.json"
      },
      {
        "speaker": "Mrs Green",
        "gender": "female",
        "text": "We can also cook delicious meals with coconut.",
        "audio": "text-b0b0090fba4a5375",
        "voice": "en-GB-SoniaNeural",
        "translation": "我们还可以用椰子做好吃的菜。",
        "audioPack": "text-u5b-02-b80d9cbdaa75.json"
      },
      {
        "speaker": "Binbin",
        "gender": "male",
        "text": "Yes!",
        "audio": "text-4fd6ea6dd7da11be",
        "voice": "en-GB-RyanNeural",
        "translation": "是啊！",
        "audioPack": "text-u5b-03-0b732cad8c1b.json"
      },
      {
        "speaker": "Binbin",
        "gender": "male",
        "text": "And some people make houses with coconut tree leaves.",
        "audio": "text-0d95969ed0a47769",
        "voice": "en-GB-RyanNeural",
        "translation": "还有人用椰子树叶盖房子。",
        "audioPack": "text-u5b-03-0b732cad8c1b.json"
      },
      {
        "speaker": "Mrs Green",
        "gender": "female",
        "text": "That's interesting.",
        "audio": "text-4d5b39b57cc5b4f4",
        "voice": "en-GB-SoniaNeural",
        "translation": "真有意思。",
        "audioPack": "text-u5b-03-0b732cad8c1b.json"
      },
      {
        "speaker": "Mrs Green",
        "gender": "female",
        "text": "Where does your coconut come from?",
        "audio": "text-7c25341d0ae7fff7",
        "voice": "en-GB-SoniaNeural",
        "translation": "你这个椰子是哪里的？",
        "audioPack": "text-u5b-04-8ac4fa9a3e11.json"
      },
      {
        "speaker": "Binbin",
        "gender": "male",
        "text": "Hainan!",
        "audio": "text-49a73097e731bbed",
        "voice": "en-GB-RyanNeural",
        "translation": "海南！",
        "audioPack": "text-u5b-04-8ac4fa9a3e11.json"
      },
      {
        "speaker": "Binbin",
        "gender": "male",
        "text": "There are many coconut trees there.",
        "audio": "text-e57d36453d0b8c93",
        "voice": "en-GB-RyanNeural",
        "translation": "那里有很多椰子树。",
        "audioPack": "text-u5b-04-8ac4fa9a3e11.json"
      }
    ]
  },
  {
    "id": "u6a",
    "unit": 6,
    "part": "a",
    "title": "Nature and us",
    "page": 64,
    "lines": [
      {
        "speaker": "Mike's dad",
        "gender": "male",
        "text": "Wow!",
        "audio": "text-e502ad8739671bc6",
        "voice": "en-GB-RyanNeural",
        "translation": "哇！",
        "audioPack": "text-u6a-01-43ef16b34f51.json"
      },
      {
        "speaker": "Mike's dad",
        "gender": "male",
        "text": "That lake is really lovely!",
        "audio": "text-8b8ce34c3c4c7100",
        "voice": "en-GB-RyanNeural",
        "translation": "那个湖真美！",
        "audioPack": "text-u6a-01-43ef16b34f51.json"
      },
      {
        "speaker": "Mr Liu",
        "gender": "male",
        "text": "Yes.",
        "audio": "text-37cb92bfecdfab71",
        "voice": "en-GB-RyanNeural",
        "translation": "是啊。",
        "audioPack": "text-u6a-01-43ef16b34f51.json"
      },
      {
        "speaker": "Mr Liu",
        "gender": "male",
        "text": "There are also many rivers in the nature park.",
        "audio": "text-56119fbdd1d2b542",
        "voice": "en-GB-RyanNeural",
        "translation": "自然公园里还有很多河流。",
        "audioPack": "text-u6a-02-a35f9990dd58.json"
      },
      {
        "speaker": "Mike's dad",
        "gender": "male",
        "text": "Is there a waterfall in the forest?",
        "audio": "text-68b22b02c151112b",
        "voice": "en-GB-RyanNeural",
        "translation": "森林里有瀑布吗？",
        "audioPack": "text-u6a-02-a35f9990dd58.json"
      },
      {
        "speaker": "Mr Liu",
        "gender": "male",
        "text": "Yes, there is.",
        "audio": "text-dac0e61c2ba50f4f",
        "voice": "en-GB-RyanNeural",
        "translation": "有的。",
        "audioPack": "text-u6a-02-a35f9990dd58.json"
      },
      {
        "speaker": "Mr Liu",
        "gender": "male",
        "text": "You'll see a beautiful one today!",
        "audio": "text-ab73521939ddbe0c",
        "voice": "en-GB-RyanNeural",
        "translation": "今天你们就能看到一处美丽的瀑布！",
        "audioPack": "text-u6a-03-a2b2fbcfeca5.json"
      },
      {
        "speaker": "Mike",
        "gender": "male",
        "text": "Great!",
        "audio": "text-a34b2bbafa1f1bc2",
        "voice": "en-GB-RyanNeural",
        "translation": "太好了！",
        "audioPack": "text-u6a-03-a2b2fbcfeca5.json"
      },
      {
        "speaker": "Mike",
        "gender": "male",
        "text": "Are there any famous mountains in the nature park?",
        "audio": "text-5b9e946c34f2d52b",
        "voice": "en-GB-RyanNeural",
        "translation": "自然公园里有名山吗？",
        "audioPack": "text-u6a-03-a2b2fbcfeca5.json"
      },
      {
        "speaker": "Mr Liu",
        "gender": "male",
        "text": "Yes, there are.",
        "audio": "text-a5778bcbc0d90005",
        "voice": "en-GB-RyanNeural",
        "translation": "有的。",
        "audioPack": "text-u6a-04-1f9738dcce76.json"
      },
      {
        "speaker": "Mr Liu",
        "gender": "male",
        "text": "We'll visit one tomorrow.",
        "audio": "text-161b970a0bd55111",
        "voice": "en-GB-RyanNeural",
        "translation": "明天我们会去游览其中一座。",
        "audioPack": "text-u6a-04-1f9738dcce76.json"
      },
      {
        "speaker": "Mr Liu",
        "gender": "male",
        "text": "There are many flowers too.",
        "audio": "text-a2fe0ce07819c1a8",
        "voice": "en-GB-RyanNeural",
        "translation": "这里还有很多花。",
        "audioPack": "text-u6a-04-1f9738dcce76.json"
      },
      {
        "speaker": "Mr Liu",
        "gender": "male",
        "text": "And there are rabbits!",
        "audio": "text-570c4ec839539e91",
        "voice": "en-GB-RyanNeural",
        "translation": "还有兔子呢！",
        "audioPack": "text-u6a-05-55117f909d9c.json"
      },
      {
        "speaker": "Mike",
        "gender": "male",
        "text": "That's great!",
        "audio": "text-bc51089c043fc5a9",
        "voice": "en-GB-RyanNeural",
        "translation": "太棒了！",
        "audioPack": "text-u6a-05-55117f909d9c.json"
      }
    ]
  },
  {
    "id": "u6b",
    "unit": 6,
    "part": "b",
    "title": "Nature and us",
    "page": 67,
    "lines": [
      {
        "speaker": "Mr Liu",
        "gender": "male",
        "text": "I'm sorry.",
        "audio": "text-9e248c37a71e1c51",
        "voice": "en-GB-RyanNeural",
        "translation": "很抱歉。",
        "audioPack": "text-u6b-01-124a6bf53fbd.json"
      },
      {
        "speaker": "Mr Liu",
        "gender": "male",
        "text": "The wind is very strong outside.",
        "audio": "text-f290fb645709803d",
        "voice": "en-GB-RyanNeural",
        "translation": "外面的风很大。",
        "audioPack": "text-u6b-01-124a6bf53fbd.json"
      },
      {
        "speaker": "Mr Liu",
        "gender": "male",
        "text": "We can't go on our trip this morning.",
        "audio": "text-c140e937e58b61c9",
        "voice": "en-GB-RyanNeural",
        "translation": "今天上午我们不能出游了。",
        "audioPack": "text-u6b-01-124a6bf53fbd.json"
      },
      {
        "speaker": "Mike's mum",
        "gender": "female",
        "text": "I agree.",
        "audio": "text-33d7f5d8289a5160",
        "voice": "en-GB-SoniaNeural",
        "translation": "我也这么想。",
        "audioPack": "text-u6b-02-34f6531cce5e.json"
      },
      {
        "speaker": "Mike's mum",
        "gender": "female",
        "text": "Strong winds are often dangerous.",
        "audio": "text-ac4609339af68bd2",
        "voice": "en-GB-SoniaNeural",
        "translation": "大风天气往往很危险。",
        "audioPack": "text-u6b-02-34f6531cce5e.json"
      },
      {
        "speaker": "Mike's dad",
        "gender": "male",
        "text": "There will be heavy rain in the afternoon too.",
        "audio": "text-c2af3101dbd9ea8f",
        "voice": "en-GB-RyanNeural",
        "translation": "下午还会下大雨。",
        "audioPack": "text-u6b-02-34f6531cce5e.json"
      },
      {
        "speaker": "Mike's dad",
        "gender": "male",
        "text": "Mike, stay in the hotel with Mum and close the windows.",
        "audio": "text-f4a3d8690b1033c2",
        "voice": "en-GB-RyanNeural",
        "translation": "迈克，你和妈妈待在旅馆里，把窗户关好。",
        "audioPack": "text-u6b-03-940fc3a76e35.json"
      },
      {
        "speaker": "Mike's dad",
        "gender": "male",
        "text": "I'll go to buy some umbrellas and raincoats.",
        "audio": "text-f1b85cf9ec44347a",
        "voice": "en-GB-RyanNeural",
        "translation": "我去买些雨伞和雨衣。",
        "audioPack": "text-u6b-03-940fc3a76e35.json"
      },
      {
        "speaker": "Mike's mum",
        "gender": "female",
        "text": "There is a small shop in the hotel.",
        "audio": "text-fb9c75b74277a567",
        "voice": "en-GB-SoniaNeural",
        "translation": "旅馆里有个小商店。",
        "audioPack": "text-u6b-03-940fc3a76e35.json"
      },
      {
        "speaker": "Mike's mum",
        "gender": "female",
        "text": "You can buy them there.",
        "audio": "text-399714e73c207d0e",
        "voice": "en-GB-SoniaNeural",
        "translation": "你可以在那里买到。",
        "audioPack": "text-u6b-04-4038aa96d5bb.json"
      },
      {
        "speaker": "Mike's dad",
        "gender": "male",
        "text": "OK.",
        "audio": "text-d3502b861fc1992d",
        "voice": "en-GB-RyanNeural",
        "translation": "好的。",
        "audioPack": "text-u6b-04-4038aa96d5bb.json"
      },
      {
        "speaker": "Mr Liu",
        "gender": "male",
        "text": "Please don't worry!",
        "audio": "text-f728c72f550e786a",
        "voice": "en-GB-RyanNeural",
        "translation": "请别担心！",
        "audioPack": "text-u6b-04-4038aa96d5bb.json"
      },
      {
        "speaker": "Mr Liu",
        "gender": "male",
        "text": "It'll be a fine day tomorrow.",
        "audio": "text-43550307821f3f10",
        "voice": "en-GB-RyanNeural",
        "translation": "明天会是个晴天。",
        "audioPack": "text-u6b-05-58f1d18c061c.json"
      }
    ]
  }
]